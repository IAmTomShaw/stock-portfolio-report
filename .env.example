# OpenAI API key
OPENAI_API_KEY=

# Resend API key
RESEND_API_KEY=

# Email address to receive weekly portfolio reports
RECIPIENT_EMAIL=

# Verified sender address used by Resend
FROM_EMAIL=

# Portfolio holdings CSV path (checked into the repo or mounted in deployment)
PORTFOLIO_CSV_PATH=./portfolio.csv

# Benchmark used for weekly comparison
BENCHMARK_TICKER=SPY
BENCHMARK_NAME=SPDR S&P 500 ETF Trust

# Reporting currency used in the email template and value calculations
# Use a 3-letter code supported by frankfurter.app, e.g. GBP, USD, or EUR
REPORT_CURRENCY=GBP

# Trigger.dev secret key (from your Trigger.dev project dashboard)
TRIGGER_SECRET_KEY=

# Trigger.dev project ref (Project Settings → Project Ref, e.g. proj_xxxxxxxxxx)
TRIGGER_PROJECT_REF=
